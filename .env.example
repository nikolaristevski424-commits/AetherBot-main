# WISPBYTE — existing Discord bot application, new AdvertiseHERE code
DISCORD_TOKEN=
CLIENT_ID=
PORT=13017
WEB_HOST=0.0.0.0
AD_PUBLIC_ORIGIN=https://advertisehere.vercel.app
AD_SHARED_SECRET=
AD_OWNER_IDS=
AD_DATA_DIR=./data
AD_REGISTER_COMMANDS=true

# VERCEL — set in encrypted Project Environment Variables, not in this .env
# AH_PUBLIC_ORIGIN=https://advertisehere.vercel.app
# AH_DISCORD_CLIENT_ID=           same existing CLIENT_ID
# AH_DISCORD_CLIENT_SECRET=       OAuth client secret, not bot token
# AH_COOKIE_SECRET=               different random secret 32+ characters
# AH_SHARED_SECRET=               exactly match AD_SHARED_SECRET
# AH_BOT_API_ORIGIN=              verified HTTPS Wispbyte origin, no port/path
