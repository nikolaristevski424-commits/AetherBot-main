{
  "name": "aether-bot",
  "version": "3.1.1",
  "description": "Aether — modular all-in-one Discord bot",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "music:check": "node scripts/check-lavalink.js",
    "test": "node --test",
    "migrate": "node scripts/migrate.js apply",
    "migrate:check": "node scripts/migrate.js check",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:keys": "node scripts/migrate-keys.js",
    "migrate:keys:dry": "node scripts/migrate-keys.js --dry-run",
    "backup:db": "node scripts/backup.js",
    "restore:db": "node scripts/restore.js",
    "backup:drill": "node scripts/restore-drill.js",
    "test:mdt": "node --test test/cad.test.js test/mdt-core.test.js test/mdt.test.js"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.1",
    "axios": "^1.15.2",
    "discord.js": "^14.26.4",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.2.1",
    "pg": "^8.11.3",
    "riffy": "1.0.12",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76",
    "@discordjs/voice": "^0.19.2",
    "opusscript": "^0.0.8"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "undici": "^6.27.0"
  }
}
