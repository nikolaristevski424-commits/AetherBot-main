# Public canonical website URL — exact HTTPS origin, no trailing slash
AETHER_SITE_ORIGIN=https://aetherbot-hq.vercel.app
# Existing Aether Discord application, no new bot needed
AETHER_DISCORD_CLIENT_ID=
# Vercel private: Discord OAuth client secret — never the DISCORD_TOKEN
AETHER_DISCORD_CLIENT_SECRET=
# Vercel private: random 32+-character session key
AETHER_SESSION_SECRET=
# Wispbyte bot public HTTPS reverse-proxy origin. The port 13017 alone is not enough.
AETHER_BOT_ORIGIN=
# The same private random 32+-character HMAC key on both Vercel and Wispbyte
AETHER_BRIDGE_SECRET=
