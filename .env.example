# AdvertiseHERE (Wispbyte bot, reuse the existing Discord application)
DISCORD_TOKEN=
CLIENT_ID=
# Wispbyte assigned port (use your allocation; shown as 13017 previously).
PORT=13017
WEB_HOST=0.0.0.0
# Your public AdvertiseHERE site.
AD_PUBLIC_ORIGIN=https://advertisehere.vercel.app
# Optional at bot startup, REQUIRED to enable private website API (32+ characters).
# Must match Vercel's AH_SHARED_SECRET exactly. Never commit a real value.
AD_SHARED_SECRET=
# Your Discord user ID(s), comma-separated. Needed for /ad-review.
AD_OWNER_IDS=
# Persistent writable data directory on Wispbyte.
AD_DATA_DIR=./data
# Set false temporarily if you do NOT want to replace the old Discord slash command set.
AD_REGISTER_COMMANDS=true

# VERCEL ONLY (put values in Project Settings -> Environment Variables, not this Wispbyte .env)
# AH_PUBLIC_ORIGIN=https://advertisehere.vercel.app
# AH_DISCORD_CLIENT_ID=              (same existing CLIENT_ID)
# AH_DISCORD_CLIENT_SECRET=          (Discord OAuth client secret, not bot token)
# AH_COOKIE_SECRET=                  (different random 32+ character secret)
# AH_SHARED_SECRET=                  (same value as AD_SHARED_SECRET)
# AH_BOT_API_ORIGIN=                 (verified HTTPS Wispbyte reverse-proxy origin, no port)
